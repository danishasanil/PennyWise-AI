# ==============================================================================
# PennyWise AI - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY GUIDELINES:
# 1. NEVER commit your actual `.env` or `.env.local` files containing real secrets to GitHub.
# 2. Server-side private secrets (GEMINI_API_KEY, PAYPAL_CLIENT_SECRET) must NEVER
#    be prefixed with `VITE_`, as VITE_ variables are bundled into client-side JS.
# 3. Firebase Web API keys are public client identifiers; actual security is enforced
#    via Firebase Authentication and Firestore Security Rules (firestore.rules).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE PRIVATE SECRETS (Node.js backend only — NEVER expose to browser)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls (PennyWise conversational companion).
# In Google AI Studio, this is automatically injected at runtime from user secrets.
# For self-hosted deployments, obtain a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# PAYPAL_CLIENT_SECRET: Private client secret for PayPal Sandbox REST API.
# Stored strictly on the backend; used for server-to-server OAuth token generation.
# NEVER share or expose this secret to the frontend.
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"

# PAYPAL_CLIENT_ID: PayPal Sandbox Client ID.
# Used on the server for authentication and returned to frontend for loading the PayPal SDK.
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"

# PAYPAL_MODE: Set to "sandbox" for development/testing, or "live" for production.
PAYPAL_MODE="sandbox"

# PAYPAL_WEBHOOK_ID: (Optional) ID of your registered PayPal Webhook.
# Used for server-side cryptographic webhook signature verification.
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# PORT: Server listening port (default: 3000).
PORT=3000

# APP_URL: The public base URL where this application is hosted.
# Used for self-referential links, webhooks, and OAuth callbacks.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Public client identifiers)
# ------------------------------------------------------------------------------
# In Google AI Studio, these values are automatically read from firebase-applet-config.json.
# For standalone GitHub clones / Vercel / Netlify deployments, configure these variables:

VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_web_app_id"
VITE_FIREBASE_MEASUREMENT_ID=""
